APP_ENV=development
REGION=test-region-1
# Copy this file to .env.local and generate random values; never commit them.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_SECRET
MIGRATION_DATABASE_URL=postgresql://sandbox_dev:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:5432/sandbox_dev
# API uses a separately provisioned LOGIN member of sandbox_api; never reuse migration credentials.
DATABASE_URL=postgresql://sandbox_api_login:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:5432/sandbox_dev
POLICY_DATABASE_URL=postgresql://sandbox_policy_login:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:5432/sandbox_dev
WORKER_DATABASE_URL=postgresql://sandbox_worker_login:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:5432/sandbox_dev
OIDC_ISSUER=http://127.0.0.1:8787
OIDC_AUDIENCE=health-sandbox-local
OIDC_CLIENT_ID=health-sandbox-web
OIDC_JWKS_URI=http://127.0.0.1:8787/jwks.json
ALLOW_DEV_AUTH=false
STORAGE_DRIVER=local
STORAGE_ROOT=./.local/quarantine
UPLOAD_MAX_BYTES=10737418240
UPLOAD_CHUNK_BYTES=8388608
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Separate 32-byte base64 secrets from local secret generator or production secret manager.
CURSOR_SIGNING_KEY=REPLACE
SESSION_SIGNING_KEY=REPLACE
