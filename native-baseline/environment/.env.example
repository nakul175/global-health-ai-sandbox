# Local development variables. Copy this file to .env.local (ignored by git) and replace every
# placeholder with a generated random value; never commit real secrets.
#
# How the application is configured
# ---------------------------------
# services/api/app/config.py reads the JSON file named by SANDBOX_CONFIG (default .local/config.json,
# generated by scripts/configure_local.py). Every field of that file can be overridden by an environment
# variable named SANDBOX_<FIELD> in upper case: SANDBOX_ALLOW_DEV_AUTH overrides "allow_dev_auth",
# SANDBOX_DATABASE_URL overrides "database_url", and so on. Variables without the SANDBOX_ prefix are not
# read. The earlier names APP_ENV, REGION, DATABASE_URL, POLICY_DATABASE_URL, WORKER_DATABASE_URL,
# OIDC_ISSUER, OIDC_AUDIENCE, ALLOW_DEV_AUTH and CURSOR_SIGNING_KEY are refused at startup so that an
# outdated .env file cannot be silently ignored.
# Nothing loads this file automatically. Export it into the shell before starting a process
# (set -a; . ./.env.local; set +a) or hand it to docker compose with --env-file .env.local.

# --- Tooling variables (not application settings) ---
# Password of the disposable loopback PostgreSQL container in environment/compose.yaml.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_SECRET
# Administrative DSN used only by database/migrate.py, scripts/provision_native.py,
# scripts/bootstrap_local.py and the test harness. Never give it to the API, policy or worker process.
MIGRATION_DATABASE_URL=postgresql://sandbox_dev:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:5432/sandbox_dev
# Configuration file to load (default .local/config.json). scripts/provision_native.py writes
# .local/native-config.json for native PostgreSQL development; select it as the README shows.
# SANDBOX_CONFIG=.local/native-config.json
# Data directory of the embedded PGlite database used by npm run dev (default .local/pg).
# SANDBOX_DATA_DIR=.local/pg

# --- Application settings: SANDBOX_<FIELD> overrides of the JSON configuration ---
# development | test | staging | production. Outside development/test, dev auth, PGlite and a private
# key file are refused and issuer/origin must use https.
SANDBOX_APP_ENV=development
# postgres | pglite
SANDBOX_DB_ENGINE=postgres
SANDBOX_REGION=test-region-1
# Separately provisioned LOGIN members of sandbox_api, sandbox_policy and sandbox_worker;
# never reuse the migration credentials.
SANDBOX_DATABASE_URL=postgresql://sandbox_api_login:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:5432/sandbox_dev
SANDBOX_POLICY_DATABASE_URL=postgresql://sandbox_policy_login:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:5432/sandbox_dev
SANDBOX_WORKER_DATABASE_URL=postgresql://sandbox_worker_login:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:5432/sandbox_dev
# Token issuer and audience the API accepts. Development uses the loopback synthetic issuer.
SANDBOX_ISSUER=http://127.0.0.1:8000/dev
SANDBOX_AUDIENCE=health-ai-sandbox
# Local JWKS file holding the issuer's public RS256 keys; the API never follows token-supplied key URLs.
SANDBOX_JWKS_FILE=.local/jwks.json
# Private signing key of the development issuer (written by scripts/configure_local.py).
# Leave empty outside development/test.
SANDBOX_PRIVATE_KEY_FILE=.local/issuer.pem
# Random secret of at least 64 characters for authenticated pagination cursors; distinct from the
# access code.
SANDBOX_CURSOR_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
# Loopback-only synthetic sign-in. Exactly true or false (any case); anything else fails startup.
# true is accepted only in development/test, with a 32+ character access code and a
# http://127.0.0.1: origin.
SANDBOX_ALLOW_DEV_AUTH=false
SANDBOX_DEV_ACCESS_CODE=
# Browser origin the API serves and accepts (scheme, host and port).
SANDBOX_ORIGIN=http://127.0.0.1:8000
