# Configure production values as secrets through Sites. Never commit private values.
# JSON private ECDSA P-256 JWK; API exposes only its public coordinates and fingerprint.
EVIDENCE_SIGNING_JWK=
# 32 random bytes encoded as 64 lowercase hex characters. Escrow separately before
# relying on checkpoints for disaster recovery. Existing archives require their key.
CHECKPOINT_KEY_HEX=
